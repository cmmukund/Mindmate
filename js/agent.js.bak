  lus:{title:'🤖 MINDMATE AI Agent',subtitle:'I cognitive activities, routine, reminders leh caregiver support atan i personal agent.',placeholder:'MINDMATE hnenah zawt rawh…',send:'Thawn',thinking:'A ngaihtuah mek…',offline:'Offline — local support a awm',ready:'A inpeih',connected:'n8n agent nen a inpeih',unavailable:'n8n agent hman theih lo. Local support hman mek.',welcome:'Chibai. MINDMATE AI Agent ka ni. Tuni journey, reminders, progress leh routine ah ka tanpui thei.',quickJourney:'Ka journey ruat rawh',quickReminders:'Reminders min entir rawh',quickProgress:'Engtin nge ka tih?',quickHelp:'Eng nge i tih theih?',context:'Ka MINDMATE activity hnuhnung ber hmang rawh',clear:'Paih'},
